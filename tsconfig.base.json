{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@aso/schemas": ["packages/schemas/src/index.ts"],
      "@aso/core": ["packages/core/src/index.ts"],
      "@aso/prompts": ["packages/prompts/src/index.ts"],
      "@aso/agents": ["packages/agents/src/index.ts"],
      "@aso/tools": ["packages/tools/src/index.ts"],
      "@aso/workflows": ["packages/workflows/src/index.ts"]
    }
  }
}
