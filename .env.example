# OpenAI — used for GPT-4o text analyses and GPT-4o vision (screenshot analysis)
OPENAI_API_KEY=sk-...

# Firecrawl — used to scrape the App Store page (reviews, subtitle, competitors, etc.)
FIRECRAWL_API_KEY=fc-...

# API server
API_PORT=3001
# Comma-separated list of allowed CORS origins for the web app
WEB_ORIGIN=http://localhost:3000

# Model overrides (optional)
ASO_TEXT_MODEL=gpt-4o
ASO_VISION_MODEL=gpt-4o

# Response cache (optional) — repeat audits for the same app are served from cache
CACHE_ENABLED=true
# How long a cached report/listing/preview stays fresh (seconds). Default 24h.
CACHE_TTL_SECONDS=86400
# Max distinct apps held in the in-memory cache before LRU eviction.
CACHE_MAX_ENTRIES=500

# Rate limiting (per IP) for the audit write endpoints (/audit/run, /audit/preview)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=10

# Audit history ("previous chats") — persisted so users can come back to past audits
HISTORY_PERSISTENCE=file          # "file" (survives restarts) or "memory"
CONVERSATIONS_FILE=./data/conversations.json
CONVERSATIONS_MAX_PER_SESSION=50
